# true: existing SQL Server test database; false: new PostgreSQL (schema/query migration required).
IDCC_DEMO_MODE=true

# Copy this file to .env. Fill in real settings locally; do not commit .env.
# For SQL Server on this same computer use host.docker.internal.
# For another SQL Server use its reachable hostname/IP, optionally host,port.
IDCC_DB_HOST=host.docker.internal
IDCC_DB_NAME=YOUR_IDCC_DATABASE
IDCC_DB_UID=YOUR_SQL_LOGIN
IDCC_DB_PWD='YOUR_SQL_PASSWORD'
# Keep false for certificate validation. Opt in only for a trusted demo server.
IDCC_DB_TRUST_SERVER_CERTIFICATE=false

SPC_DB_HOST=host.docker.internal
SPC_DB_NAME=YOUR_SPC_DATABASE
SPC_DB_UID=YOUR_SQL_LOGIN
SPC_DB_PWD='YOUR_SQL_PASSWORD'
SPC_DB_TRUST_SERVER_CERTIFICATE=false

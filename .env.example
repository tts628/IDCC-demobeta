# Demo defaults to true: IDCC pages use DemoIDCC. SPC always stays independent.
IDCC_DEMO_MODE=true
IDCC_CONNECTION_LAYOUT=2

# DemoIDCC: existing SQL Server test database. This is a profile name, not a fixed database name.
DEMOIDCC_DB_HOST=YOUR_DEMO_SQL_SERVER
DEMOIDCC_DB_NAME=YOUR_DEMO_DATABASE
DEMOIDCC_DB_UID=YOUR_SQL_LOGIN
DEMOIDCC_DB_PWD='YOUR_SQL_PASSWORD'
DEMOIDCC_DB_TRUST_SERVER_CERTIFICATE=false

# Independent SPC SQL Server connection.
SPC_DB_HOST=YOUR_SPC_SQL_SERVER
SPC_DB_NAME=YOUR_SPC_DATABASE
SPC_DB_UID=YOUR_SQL_LOGIN
SPC_DB_PWD='YOUR_SQL_PASSWORD'
SPC_DB_TRUST_SERVER_CERTIFICATE=false

# The installer generates IDCC_DB_* PostgreSQL connection fields in .env.postgres.
# Do not put the old SQL Server connection in IDCC_DB_*; use DEMOIDCC_DB_* above.
